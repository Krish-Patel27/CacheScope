# ==============================================================================
# CacheScope - .gitignore
# ==============================================================================

# --- Byte-compiled / optimized / DLL files ---
__pycache__/
*.py[cod]
*$py.class
*.so

# --- C extensions ---
*.c
*.pyd

# --- Virtual Environments ---
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# --- Local Databases & Runtime Artifacts ---
*.db
*.sqlite
*.sqlite3

# --- Temporary / Extracted Text Dumps ---
pdf_text.txt

# --- Streamlit Secrets & Credentials ---
# Keep custom configs but ignore secrets/credentials
.streamlit/secrets.toml

# --- Testing & Code Coverage ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
nosetests.xml
coverage.xml
*.cover
*.py,cover

# --- Jupyter / IPython Notebooks ---
.ipynb_checkpoints/
*-checkpoint.ipynb

# --- Distribution / Packaging ---
dist/
build/
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# --- IDEs & Code Editors ---
# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# PyCharm / JetBrains
.idea/

# Vim / Emacs
*.swp
*.swo
*~
.#*

# --- Operating System Files ---
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Linux
*~
.directory

# --- Logs & Diagnostics ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
